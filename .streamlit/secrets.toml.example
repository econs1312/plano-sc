# Chave da API Google Gemini (Obtenha gratuitamente em https://aistudio.google.com/apikey)
GEMINI_API_KEY = "sua_chave_gemini_aqui"

# Senha de acesso ao Painel de Curadoria (?admin=1)
ADMIN_PASSWORD = "pesquisa_plano_sc"

# URL da planilha do Google Drive
GSHEETS_URL = "https://docs.google.com/spreadsheets/d/1Um65rCo3IEcC2fdkgey-TkP_DIT3qqlajp3h3Um1QSY/edit"

# ==============================================================================
# OPÇÃO 1: Integração com Conta de Serviço do Google Cloud (Padrão Streamlit)
# Crie uma conta de serviço no Google Cloud Console, baixe a chave JSON e cole aqui:
# E compartilhe a planilha com o client_email como "Editor".
# ==============================================================================
[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/1Um65rCo3IEcC2fdkgey-TkP_DIT3qqlajp3h3Um1QSY/edit"
worksheet = "Dados"
type = "service_account"
project_id = "seu-projeto-gcp"
private_key_id = "chave_id_exemplo"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
client_email = "plano-sc-bot@seu-projeto-gcp.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/plano-sc-bot%40seu-projeto-gcp.iam.gserviceaccount.com"

# ==============================================================================
# OPÇÃO 2 (Alternativa sem Google Cloud): Webhook via Google Apps Script
# Se preferir não usar o Google Cloud Console, crie um script simples na planilha
# (Extensões > Apps Script) e cole a URL da Web App gerada aqui:
# ==============================================================================
# GSHEETS_WEBHOOK_URL = "https://script.google.com/macros/s/AKfycbx.../exec"
